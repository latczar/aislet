{
  "expo": {
    "name": "Aislet",
    "slug": "untethered",
    "scheme": "aislet",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F4F5",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.untethered.assistant",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "permissions": ["android.permission.MANAGE_EXTERNAL_STORAGE", "com.android.alarm.permission.SET_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Aislet",
      "shortName": "Aislet",
      "themeColor": "#18181B",
      "backgroundColor": "#F4F4F5",
      "description": "Private offline AI with its own library."
    },
    "plugins": [
      "llama.rn",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class org.kiwix.** { *; }\n-keep class com.tom_roush.** { *; }\n-dontwarn com.gemalto.jp2.**",
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      "expo-font",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/*", "image/*", "application/pdf"],
            "multipleShareMimeTypes": ["image/*"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aislet uses your photos when you attach one to a chat.",
          "cameraPermission": "Aislet uses the camera when you take a photo to ask about."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aislet uses the camera when you take a photo to ask about, or scan your laptop's pairing code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Aislet listens when you tap the microphone to talk.",
          "speechRecognitionPermission": "Aislet turns your speech into text when you tap the microphone."
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withBackupOff",
      "./plugins/withScannerOffline"
    ]
  }
}
