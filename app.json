{
  "expo": {
    "name": "Untethered",
    "slug": "untethered",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F3F2",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.untethered.assistant",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#2F6F5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Untethered",
      "shortName": "Untethered",
      "themeColor": "#2F6F5E",
      "backgroundColor": "#F1F3F2",
      "description": "Your private AI that works offline."
    },
    "plugins": [
      "llama.rn",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Untethered uses your photos when you attach one to a chat.",
          "cameraPermission": "Untethered uses the camera when you take a photo to ask about."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Untethered listens when you tap the microphone to talk.",
          "speechRecognitionPermission": "Untethered turns your speech into text when you tap the microphone."
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}